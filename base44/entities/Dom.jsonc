{
  "name": "Dom",
  "type": "object",
  "properties": {
    "nazov": {
      "type": "string",
      "description": "N\u00e1zov modelu domu"
    },
    "slug": {
      "type": "string",
      "description": "SEO friendly URL slug"
    },
    "prosto_house_kod": {
      "type": "string",
      "description": "\u0160peci\u00e1lne identifika\u010dn\u00e9 \u010d\u00edslo pre Prosto House domy (napr. PH-001, PH-002)"
    },
    "vyrobca": {
      "type": "string",
      "enum": [
        "JAK Modules",
        "Ticab house",
        "Prosto House",
        "Domki z G\u00f3r"
      ],
      "description": "V\u00fdrobca domu"
    },
    "typ_domu": {
      "type": "string",
      "enum": [
        "modularny",
        "mobilny",
        "montovany"
      ],
      "description": "Typ domu"
    },
    "kategoria": {
      "type": "string",
      "enum": [
        "rodinne_domy",
        "mobilne_domy"
      ],
      "default": "rodinne_domy",
      "description": "Kateg\u00f3ria domu - Rodinn\u00e9 domy alebo Mobiln\u00e9 domy"
    },
    "celorocny": {
      "type": "boolean",
      "default": true,
      "description": "\u010ci je dom celoro\u010dn\u00fd"
    },
    "pocet_izieb": {
      "type": "number",
      "description": "Po\u010det izieb"
    },
    "pocet_modulov": {
      "type": "number",
      "description": "Po\u010det modulov (pre Ticab house)"
    },
    "zastavana_plocha": {
      "type": "number",
      "description": "Zastavana plocha v m\u00b2"
    },
    "uzitkova_plocha": {
      "type": "number",
      "description": "\u00da\u017eitkov\u00e1 plocha v m\u00b2"
    },
    "terasa_plocha": {
      "type": "number",
      "description": "Plocha terasy zahrnutej v cene v m\u00b2 (pre Ticab house modely)"
    },
    "zakladna_cena": {
      "type": "number",
      "description": "Z\u00e1kladn\u00e1 cena v EUR s DPH"
    },
    "konfigurator_ceny": {
      "type": "object",
      "description": "Ceny polo\u017eiek pre konfigur\u00e1tor Ticabhouse"
    },
    "konfigurator_skryte_polozky": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Zoznam ID polo\u017eiek ktor\u00e9 s\u00fa skryt\u00e9 v konfigur\u00e1tore Ticabhouse"
    },
    "konfigurator_custom_ceny_prosto_house": {
      "type": "object",
      "description": "Vlastn\u00e9 ceny polo\u017eiek pre konfigur\u00e1tor Prosto House"
    },
    "prosto_skryte_polozky": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Zoznam ID polo\u017eiek ktor\u00e9 s\u00fa skryt\u00e9 v konfigur\u00e1tore Prosto House"
    },
    "doprava_viditelna": {
      "type": "boolean",
      "default": true,
      "description": "\u010ci je doprava vidite\u013en\u00e1 v konfigur\u00e1tore pre verejnos\u0165"
    },
    "hlavny_obrazok": {
      "type": "string",
      "description": "URL hlavn\u00e9ho obr\u00e1zka"
    },
    "zakladna_konfiguracia_obrazok": {
      "type": "string",
      "description": "URL obr\u00e1zka domu v z\u00e1kladnej konfigur\u00e1cii"
    },
    "galeria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gal\u00e9ria obr\u00e1zkov"
    },
    "stare_fotky": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Star\u00e9 fotky (arch\u00edv pred v\u00fdmenou)"
    },
    "nove_fotky": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nov\u00e9 fotky na v\u00fdmenu"
    },
    "galerie": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nazov": {
            "type": "string",
            "description": "N\u00e1zov gal\u00e9rie"
          },
          "typ": {
            "type": "string",
            "enum": [
              "exterier_drevo_plech",
              "exterier_murovka",
              "interier_drevo",
              "interier_sadrokarton"
            ],
            "description": "Typ gal\u00e9rie"
          },
          "fotky": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "URL fotiek v gal\u00e9rii"
          }
        }
      },
      "description": "Pomenovan\u00e9 gal\u00e9rie s r\u00f4znymi typmi fotiek"
    },
    "podorys_2d": {
      "type": "string",
      "description": "URL 2D p\u00f4dorysu"
    },
    "podorys_3d": {
      "type": "string",
      "description": "URL 3D p\u00f4dorysu"
