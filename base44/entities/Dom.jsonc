    },
    "popularny": {
      "type": "boolean",
      "default": false,
      "description": "Popul\u00e1rny model"
    },
    "poradie": {
      "type": "number",
      "description": "Poradie zobrazoovania"
    },
    "youtube_url": {
      "type": "string",
      "description": "URL YouTube videa"
    },
    "verejny": {
      "type": "boolean",
      "default": true,
      "description": "\u010ci je dom vidite\u013en\u00fd pre verejnos\u0165"
    },
    "ai_summary": {
      "type": "string",
      "description": "2-vetn\u00e9 zhrnutie domu pre r\u00fdchle odpovede AI (AEO)"
    },
    "faq_schema_data": {
      "type": "object",
      "description": "Multi-language FAQ schema - kl\u00fa\u010de s\u00fa k\u00f3dy jazykov (sk, en, hu, pl, uk, de, fr, sr, hr, el)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "faqs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "otazka": {
                  "type": "string"
                },
                "odpoved": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "product_schema_json": {
      "type": "object",
      "description": "Auto-generated Product JSON-LD schema for SEO (0 credits)"
    },
    "geo_context_keywords": {
      "type": "string",
      "description": "K\u013e\u00fa\u010dov\u00e9 slov\u00e1 s tematickou autoritou (napr. 'montovan\u00fd dom, ekologick\u00e1 stavba, energeticky efekt\u00edvny')"
    },
    "images_seo_map": {
      "type": "object",
      "description": "Multi-language SEO alt texty pre obr\u00e1zky - kl\u00fa\u010de s\u00fa k\u00f3dy jazykov (sk, en, hu, pl, uk, de, fr, sr, hr, el), hodnoty s\u00fa objekty kde kl\u00fa\u010d je URL obr\u00e1zka a hodnota je alt text",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "aeo_update_pending": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicating that this house needs AEO regeneration in the next batch process"
    }
  },
  "required": [
    "nazov",
    "vyrobca",
    "typ_domu",
    "zastavana_plocha",
    "zakladna_cena",
    "hlavny_obrazok"
  ]
}