    "meta_title": {
      "type": "string",
      "description": "SEO meta titulok"
    },
    "meta_description": {
      "type": "string",
      "description": "SEO meta popis"
    },
    "podorysy": {
      "type": "array",
      "items": {
        "type": "string"
      },
