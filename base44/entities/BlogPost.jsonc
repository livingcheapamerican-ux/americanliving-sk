      "type": "string",
      "description": "Kr\u00e1tky \u00favodn\u00fd text (po\u013esky)"
    },
    "perex_uk": {
      "type": "string",
      "description": "Kr\u00e1tky \u00favodn\u00fd text (ukrajinsky)"
    },
    "perex_de": {
      "type": "string",
      "description": "Kr\u00e1tky \u00favodn\u00fd text (nemecky)"
    },
    "perex_fr": {
      "type": "string",
