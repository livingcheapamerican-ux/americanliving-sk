{
  "name": "MarketingInsight",
  "type": "object",
  "properties": {
    "dom_id": {
      "type": "string",
      "description": "ID domu, ktor\u00e9ho sa poznatok t\u00fdka"
    },
    "dom_nazov": {
      "type": "string",
      "description": "N\u00e1zov domu"
    },
    "vyrobca": {
      "type": "string",
      "description": "V\u00fdrobca domu"
    },
    "celkovy_zajem": {
      "type": "object",
      "properties": {
        "pocet_zobrazeni": {
          "type": "number"
        },
        "pocet_konfiguracii": {
          "type": "number"
        },
        "priemerny_cas_na_stranke": {
          "type": "number"
        },
        "miera_konverzie": {
          "type": "number"
        }
      },
      "description": "Celkov\u00e9 \u0161tatistiky z\u00e1ujmu o dom"
    },
    "geograficke_cielenie": {
      "type": "object",
      "properties": {
        "top_krajiny": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "krajina": {
                "type": "string"
              },
              "pocet_navstev": {
                "type": "number"
              },
              "percento": {
                "type": "number"
              }
            }
          }
        },
        "top_regiony": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "region": {
                "type": "string"
              },
              "pocet_navstev": {
                "type": "number"
              },
              "percento": {
                "type": "number"
              }
            }
          }
        },
        "top_mesta": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mesto": {
                "type": "string"
              },
              "pocet_navstev": {
                "type": "number"
              },
              "percento": {
                "type": "number"
              }
            }
          }
        }
      },
      "description": "Geografick\u00e9 cielenie pre reklamy"
    },
    "zariadenia_a_platforma": {
      "type": "object",
      "properties": {
        "desktop": {
          "type": "number"
        },
        "mobile": {
          "type": "number"
        },
        "tablet": {
