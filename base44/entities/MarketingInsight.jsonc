          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ai_predikcia_konverzie": {
          "type": "object",
          "properties": {
            "najpravdepodobnejsi_typ": {
              "type": "string",
              "enum": [
                "prieskumnici",
                "rozhodovatelia",
                "vracajuci_sa"
              ]
            },
            "pravdepodobnost_konverzie": {
              "type": "number",
              "description": "Pravdepodobnos\u0165 konverzie v % pre najpravdepodobnej\u0161\u00ed typ"
            },
            "dovod": {
              "type": "string",
              "description": "AI zd\u00f4vodnenie pre\u010do tento typ konvertuje najlep\u0161ie"
            },
            "odporucania_pre_typ": {
              "type": "string",
              "description": "\u0160pecifick\u00e9 odpor\u00fa\u010dania ako cieli\u0165 tento typ"
            },
            "detailna_analyza_typov": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "typ": {
                    "type": "string"
                  },
                  "konverzna_pravdepodobnost": {
                    "type": "number"
                  },
                  "charakteristiky": {
                    "type": "string"
                  },
                  "ako_cielit": {
                    "type": "string"
                  }
                }
              }
            },
            "kreativne_varianty_pre_typy": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "typ_skupiny": {
                    "type": "string"
                  },
                  "varianty": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "nazov": {
                          "type": "string"
                        },
                        "obrazok_popis": {
                          "type": "string"
                        },
                        "video_koncept": {
                          "type": "string"
                        },
                        "nadpis": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        },
                        "cta": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "description": "Behavior\u00e1lna anal\u00fdza n\u00e1v\u0161tevn\u00edkov"
    },
    "klucove_slova": {
